<div class="post-grid">
  <% page.posts.each(function(post) { %>
    <a href="<%= url_for(post.path) %>" class="post-card">
      <div class="card-content">
        <h3 class="card-title"><%= post.title %></h3>
        <span class="card-date">
          <%= date(post.date, 'YYYY.MM.DD') %>
        </span>
      </div>
    </a>
  <% }); %>
</div>

<%- partial('_partial/pagination') %>
